<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:background="@color/bg">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="22dp">

		<ImageView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="12dp"
			android:src="@drawable/logo"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="10dp"
			android:text="@string/app_name"
			android:textColor="@color/accent"
			android:textSize="26sp"
			android:textStyle="bold"
			android:letterSpacing="0.15"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="2dp"
			android:layout_marginBottom="18dp"
			android:text="내 프록시로 휴대폰 전체 연결"
			android:textColor="@color/muted"
			android:textSize="13sp"/>

		<TextView
			android:id="@+id/status"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:paddingVertical="14dp"
			android:text="○ 연결 안 됨"
			android:textColor="@color/muted"
			android:textSize="18sp"
			android:textStyle="bold"
			android:background="@color/surface"/>

		<TextView style="@style/Lbl" android:text="한 줄 붙여넣기 (선택)"/>
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:layout_marginBottom="4dp">
			<EditText
				android:id="@+id/paste"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:hint="예) 1.2.3.4:8080:아이디:비번"
				style="@style/Field"/>
			<Button
				android:id="@+id/applyPaste"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:text="풀기"
				android:textColor="@color/accent"
				android:backgroundTint="@color/field"/>
		</LinearLayout>

		<TextView style="@style/Lbl" android:text="종류"/>
		<Spinner
			android:id="@+id/type"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/field"
			android:padding="12dp"/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<LinearLayout
				android:layout_width="0dp" android:layout_height="wrap_content"
				android:layout_weight="6" android:orientation="vertical">
				<TextView style="@style/Lbl" android:text="서버 주소"/>
				<EditText android:id="@+id/server" style="@style/Field"
					android:hint="IP 또는 도메인" android:inputType="textUri"/>
			</LinearLayout>
			<LinearLayout
				android:layout_width="0dp" android:layout_height="wrap_content"
				android:layout_weight="4" android:orientation="vertical"
				android:layout_marginStart="10dp">
				<TextView style="@style/Lbl" android:text="포트"/>
				<EditText android:id="@+id/port" style="@style/Field"
					android:hint="8080" android:inputType="number"/>
			</LinearLayout>
		</LinearLayout>

		<TextView style="@style/Lbl" android:text="아이디 (없으면 비워두기)"/>
		<EditText android:id="@+id/user" style="@style/Field"
			android:hint="아이디" android:inputType="text"/>

		<TextView style="@style/Lbl" android:text="비밀번호"/>
		<EditText android:id="@+id/pass" style="@style/Field"
			android:hint="비밀번호" android:inputType="textPassword"/>

		<Button
			android:id="@+id/connect"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:layout_marginTop="22dp"
			android:text="연결하기"
			android:textColor="#1a1013"
			android:textSize="17sp"
			android:textStyle="bold"
			android:backgroundTint="@color/accent"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="18dp"
			android:text="· 연결은 이 버튼으로 켜고 끕니다.\n· NordVPN 등 다른 VPN은 꺼 주세요 (VPN은 한 번에 하나만 켜져요).\n· 연결이 안 되면 위의 상태 글자를 길게 눌러 로그를 확인하세요.\n· 끊기면 인터넷 자동 차단을 원하면: 설정 → 네트워크 → VPN → 숨결 → 항상 연결 + 연결 없이 차단\n· SOCKS5 프록시를 권장합니다."
			android:textColor="@color/muted"
			android:textSize="12sp"
			android:lineSpacingExtra="4dp"/>

	</LinearLayout>
</ScrollView>
